#Pod-4
---
apiVersion: v1
kind: Pod
metadata:
  name: pod-4
  namespace: dev
  labels:
    app: makeup
spec:
  containers:
    - image: apsanadevops/beauty:makeup
      name: con-1
      ports:
        - containerPort: 80



#Deny-all  -> Denying all communication b/w all pods
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: deny-all
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress


#### Enabling communication b/w pod2 of default ns and pod4 of dev ns alone ###
kubectl label ns dev env=dev
kubectl label ns default env=default
# pod4-makeup-ingress-egress  ->  deciding which pod can send data to pod4 and to which Pod, pod4's data can be sent to.
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: makeup-comm
  namespace: dev
spec:
  podSelector:
    matchLabels:
      app: makeup
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - podSelector:
             matchLabels:
                app: jewels
          namespaceSelector:
            matchLabels:
              env: default
        - ipBlock:
            cidr: 100.96.1.0/24
            except:
              - 100.96.1.210/32

egress:
    - to:
        - podSelector:
            matchLabels:
              app: jewels
          namespaceSelector:
            matchLabels:
              env: default
        - ipBlock:
            cidr: 100.96.1.0/24
            except:
              - 100.96.1.210/32


# pod2-jewels-ingress-egress  ->  deciding which pod can send data to pod2 and to which Pod, pod2's data can be sent to.
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: jewels-comm
  namespace: default
spec:
  podSelector:
    matchLabels:
      app: jewels
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: makeup
          namespaceSelector:
            matchLabels:
              env: dev
        - ipBlock:
            cidr: 100.96.1.0/24
            except:
              - 100.96.1.78/32

  egress:
    - to:
      - podSelector:
          matchLabels:
            app: makeup
        namespaceSelector:
          matchLabels:
            env: dev
        - ipBlock:
            cidr: 100.96.1.0/24
            except:
              - 100.96.1.78/32


### Since we have useddeny-all,the communication b/w namspace is also restricted, so we need to allow few egress policy(such as TCP, UDP, DNS) for our pod with label app: makeup to allow them communicate b/w namespace.
######  However this is not required if Deny-all is not applied. #######
apiVersion: networking.k8s.io/v1 
kind: NetworkPolicy
metadata:
  name: makeup-allow-internet
  namespace: dev
spec:
  podSelector:
    matchLabels:
      app: makeup

  policyTypes:
    - Egress

  egress :
    # Allow HTTP/HTTPS internet traffic
    - ports:
      - protocol: TCP
        port: 80
      - protocol: TCP
        port: 443

    # Allow DNS
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
