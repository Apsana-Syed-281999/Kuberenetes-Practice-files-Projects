---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: sts1
spec:
  selector:
    matchLabels:
      app: makeup
  replicas: 3
  template:
    metadata:
      name: tmplt1
      labels:
        app: makeup
    spec:
      containers:
        - name: con1
          image: apsanadevops/beauty:makeup
          ports:
            - containerPort: 80
      tolerations:
        - key: env
          operator: Equal
          value: prod
          effect: NoSchedule
