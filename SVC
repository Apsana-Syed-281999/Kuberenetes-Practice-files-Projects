###ClusterIP
---
apiVersion: v1
kind: Service
metadata:
  name: svc1
spec:
  type: ClusterIP
  selector:
      app: swiggy
  ports:
    - port: 80
      targetPort: 80


###NodePort
---
apiVersion: v1
kind: Service
metadata:
  name: svc1
spec:
  type: NodePort
  selector:
      app: swiggy
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30001


###LoadBalancer
---
apiVersion: v1
kind: Service
metadata:
  name: svc3
spec:
  type: LoadBalancer
  selector:
    app: zomato
  ports:
    - port: 80
      targetPort: 80
