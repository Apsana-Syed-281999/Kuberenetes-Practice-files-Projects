###Deploy
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: deply1
spec:
  selector:
    matchLabels:
      app: makeup
  replicas: 3
  template:
    metadata:
      name: tmplt1
      labels:
        app: makeup
    spec:
      containers:
        - name: con1
          image: apsanadevops/beauty:makeup
          ports:
            - containerPort: 80

###HorizontalPodAutoScaler
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: hpa1
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: dply2
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 60



